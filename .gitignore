# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Data & Exports (Don't commit large datasets to git)
data/raw/*
data/processed/*
data/exports/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/exports/.gitkeep

# Logs
logs/*
!logs/.gitkeep
*.log

# Environments & Secrets
.env
.venv/
venv/
ENV/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.tmp

# Scratch / Test scripts
scratch_*.py
